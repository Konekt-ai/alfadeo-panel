# Copia este archivo como .env.local y llena los valores.
# En Vercel se cargan en Settings -> Environment Variables.

# ===== Supabase =====
SUPABASE_URL=https://tu-proyecto.supabase.co

# Service Role Key, NO la anon key.
# Salta las políticas RLS: nunca la expongas al navegador ni la subas al repo.
SUPABASE_SERVICE_ROLE_KEY=

# ===== Acceso al panel =====
# Contraseña compartida para entrar. OBLIGATORIA en producción: sin ella el
# panel responde 503 en vez de quedar abierto en una URL pública.
# En desarrollo local se puede dejar vacía y no pide contraseña.
PANEL_PASSWORD=

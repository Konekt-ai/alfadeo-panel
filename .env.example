# Copia este archivo como .env.local y llena los valores.
#
# En la computadora del mostrador esto lo hace el instalador:
#   powershell -ExecutionPolicy Bypass -File instalacion\instalar.ps1

# ===== Supabase =====
# Project Settings -> API
SUPABASE_URL=https://tu-proyecto.supabase.co

# Service Role Key, NO la anon key.
# Salta las políticas RLS: nunca la expongas al navegador ni la subas al repo.
SUPABASE_SERVICE_ROLE_KEY=

# Copia este archivo como .env.local y llena los valores.
#
# En la computadora del mostrador esto lo hace el instalador:
#   powershell -ExecutionPolicy Bypass -File instalacion\instalar.ps1

# ===== Base de datos =====
# PostgreSQL corre en la MISMA computadora que el panel. No hay nube.
# El instalador genera la contraseña y escribe esta línea solo.
DATABASE_URL=postgresql://alfadeo:CONTRASENA@localhost:5433/alfadeo
